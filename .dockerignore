# Arquivos que não entram no contexto de build do Docker.
# Atenção: o Dockerfile de produção (na raiz) copia o projeto inteiro, então
# este arquivo NÃO pode excluir o código.
.git
.github
.env
.env.*
!.env.example
node_modules
vendor
public/build
public/hot
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/.container-ready
bootstrap/cache/*.php
tests
.phpunit.result.cache
*.log
